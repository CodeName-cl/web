    <div class="hamburger-menu">
      <img src="/images/icons/burger.webp" alt="Menu" />
    </div>

    <nav>
      <ul>
        <li><a href="/#apps-section">Aplicaciones</a></li>
        <li><a href="/#why-choose-us">¿Por qué elegirnos?</a></li>
        <li><a href="/#contact">Contacto</a></li>
        <li><a href="/docs">Documentación</a></li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  // Hamburger menu toggle
  const hamburger = document.querySelector(".hamburger-menu");
  const navLinks = document.querySelector("nav ul");

  function toggleMenu() {
    navLinks.classList.toggle("show");
  }

  hamburger.addEventListener("click", (event) => {
    event.stopPropagation();
    toggleMenu();
  });

  const navItems = document.querySelectorAll("nav ul li a");
  navItems.forEach((item) => {
    item.addEventListener("click", () => {
      navLinks.classList.remove("show");
    });
  });

  document.addEventListener("click", (event) => {
    const isClickInsideNav = navLinks.contains(event.target);
    const isClickOnHamburger = hamburger.contains(event.target);
    if (!isClickInsideNav && !isClickOnHamburger) {
      navLinks.classList.remove("show");
    }
  });

  // Sticky header scroll behavior
  const header = document.querySelector("header");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      header.classList.add("scrolled");
    } else {
      header.classList.remove("scrolled");
    }
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
    width: 100%;
  }
  .header-content {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  header :global(.scrolled) {
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }

  .logo {
    width: 100px;
    padding: 12px 0;
    margin-left: -60px;
  }

  nav ul {
    display: none;
    list-style: none;
    padding: 0;
  }
  nav ul :global(.show) {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: 60px;
    left: 0;
    right: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    z-index: 100;
  }
  nav ul li {
    text-align: center;
  }
  nav ul li a {
    display: block;
    padding: 16px 20px;
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }
  nav ul li a:hover {
    background: rgba(99, 102, 241, 0.06);
    color: var(--primary);
  }

  .hamburger-menu {
    float: left;
    padding: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .hamburger-menu:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .hamburger-menu img {
    width: 24px;
    height: 24px;
    filter: brightness(0) invert(1);
    transition: filter 0.3s ease;
  }

  @media screen and (min-width: 768px) {
    .header-content {
      max-width: 720px;
    }
    .logo {
      margin-left: 0;
    }
    .hamburger-menu {
      display: none;
    }
    nav ul {
      display: flex !important;
      flex-direction: row;
      position: static;
      background: transparent;
      border: none;
      box-shadow: none;
      gap: 4px;
    }
    nav ul li a {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px 18px;
      border-radius: 10px;
      width: auto;
      height: 44px;
      color: rgba(255, 255, 255, 0.9);
    }
    nav ul li a:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #ffffff;
    }
  }
</style>

<style is:global>
  /* Header scrolled state - global because JS adds class dynamically */
  header.scrolled {
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }
  header.scrolled .cls-1 {
    fill: var(--text-secondary);
  }
  header.scrolled nav ul li a {
    color: var(--text-secondary);
  }
  header.scrolled nav ul li a:hover {
    background: rgba(99, 102, 241, 0.08);
    color: var(--primary);
  }
  header.scrolled .hamburger-menu img {
    filter: none;
  }
  header.scrolled .hamburger-menu:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  header a {
    text-decoration: none;
  }

  /* Nav show state - global because JS toggles class */
  nav ul.show {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: 60px;
    left: 0;
    right: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    z-index: 100;
  }
  nav ul.show li a {
    color: var(--text-secondary);
  }
  nav ul.show li a:hover {
    background: rgba(99, 102, 241, 0.06);
    color: var(--primary);
  }
</style>
