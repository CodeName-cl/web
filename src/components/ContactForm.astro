---
import type { Lang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="fade-in">
  <div class="section-header">
    <span class="file-no"><span>//</span> OP.04 · Contacto</span>
    <h2>{t("contact.title")}</h2>
  </div>

  <div class="contact-container">
    <p>
      {t("contact.description")}
    </p>

    <form id="contactForm" data-success-message={t("contact.success")}>
      <label for="name">{t("contact.name")}</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder={t("contact.namePlaceholder")}
        required
      />
      <label for="email">{t("contact.email")}</label>
      <input
        type="email"
        id="email"
        name="email"
        placeholder={t("contact.emailPlaceholder")}
        required
      />
      <label for="message">{t("contact.message")}</label>
      <textarea
        id="message"
        name="message"
        placeholder={t("contact.messagePlaceholder")}
        required></textarea>
      <div class="submit-container">
        <button type="submit">{t("contact.submit")}</button>
      </div>
    </form>
  </div>
</section>

<script is:inline>
  document
    .getElementById("contactForm")
    .addEventListener("submit", function (e) {
      e.preventDefault();

      const formData = new FormData(this);
      const jsonData = {
        fields: {
          1279: formData.get("email"),
          1280: formData.get("name"),
          1281: formData.get("message"),
        },
        subscribe: true,
        "mc-SMSPHONE-ack": false,
      };

      fetch(
        "https://proxy-mailchimp-66181581846.us-central1.run.app/proxy?site=codename",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(jsonData),
        }
      )
        .then((response) => {})
        .catch((error) => {});

      var successMessage = this.getAttribute("data-success-message");
      document.getElementById("contactForm").innerHTML =
        '<div class="p-4 rounded"><p>' + successMessage + "</p></div>";
    });
</script>

<style>
  #contact {
    padding: 80px 20px 96px;
    background: var(--surface);
  }
  #contact .section-header {
    margin-bottom: 32px;
    max-width: 1080px;
  }
  #contact > .contact-container > p {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text);
    margin-bottom: 24px;
    max-width: 520px;
  }
  #contact form {
    margin-top: 8px;
  }
  #contact button {
    margin-top: 16px;
    padding: 14px 28px;
    background: var(--gradient-orange);
    color: #ffffff;
    border: none;
    font-weight: 700;
    border-radius: var(--border-radius);
    min-height: 52px;
    box-shadow: 0 4px 14px rgba(235, 94, 40, 0.30);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  #contact button:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 25px rgba(235, 94, 40, 0.40);
  }
  #contact button:active {
    transform: scale(0.98);
  }
  .submit-container {
    padding-top: 8px;
    text-align: right;
  }
  .contact-container {
    max-width: 1080px;
    margin: 0 auto;
  }

  @media screen and (min-width: 768px) {
    .contact-container {
      display: grid;
      grid-template-columns: 1fr 1.25fr;
      gap: 48px;
      align-items: start;
    }
    #contact > .contact-container > p {
      padding-top: 0;
      margin-bottom: 0;
      font-size: 1.125rem;
    }
    #contact form {
      margin-top: 0;
    }
  }
</style>
