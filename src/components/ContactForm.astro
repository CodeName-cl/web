---
import type { Lang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="fade-in">
  <h2>{t("contact.title")}</h2>

  <div class="contact-container">
    <p>
      {t("contact.description")}
    </p>

    <form id="contactForm" data-success-message={t("contact.success")}>
      <label for="name">{t("contact.name")}</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder={t("contact.namePlaceholder")}
        required
      />
      <label for="email">{t("contact.email")}</label>
      <input
        type="email"
        id="email"
        name="email"
        placeholder={t("contact.emailPlaceholder")}
        required
      />
      <label for="message">{t("contact.message")}</label>
      <textarea
        id="message"
        name="message"
        placeholder={t("contact.messagePlaceholder")}
        required></textarea>
      <div class="submit-container">
        <button type="submit">{t("contact.submit")}</button>
      </div>
    </form>
  </div>
</section>

<script is:inline>
  document
    .getElementById("contactForm")
    .addEventListener("submit", function (e) {
      e.preventDefault();

      const formData = new FormData(this);
      const jsonData = {
        fields: {
          1279: formData.get("email"),
          1280: formData.get("name"),
          1281: formData.get("message"),
        },
        subscribe: true,
        "mc-SMSPHONE-ack": false,
      };

      fetch(
        "https://proxy-mailchimp-66181581846.us-central1.run.app/proxy?site=codename",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(jsonData),
        }
      )
        .then((response) => {})
        .catch((error) => {});

      var successMessage = this.getAttribute("data-success-message");
      document.getElementById("contactForm").innerHTML =
        '<div class="p-4 rounded"><p>' + successMessage + "</p></div>";
    });
</script>

<style>
  #contact {
    padding-bottom: 80px;
  }
  #contact h2 {
    margin-bottom: 24px;
  }
  #contact > .contact-container > p {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 24px;
  }
  #contact form {
    margin-top: 24px;
  }
  #contact button {
    margin-top: 16px;
    padding: 12px 24px;
    background: var(--gradient-accent);
    color: white;
    border: none;
    min-height: 52px;
    box-shadow: 0 4px 14px rgba(235, 94, 40, 0.3);
  }
  #contact button:hover {
    transform: scale(1.02);
    box-shadow: 0 6px 20px rgba(235, 94, 40, 0.4);
  }
  #contact button:active {
    transform: scale(0.98);
  }
  .submit-container {
    padding-top: 8px;
    text-align: right;
  }
  #contact {
    padding-left: 20px;
    padding-right: 20px;
  }

  @media screen and (min-width: 768px) {
    .contact-container {
      display: flex;
      gap: 40px;
    }
    #contact > .contact-container > p {
      flex: 1;
      padding-top: 0;
    }
    #contact form {
      flex: 1;
      margin-top: 0;
    }
  }
</style>
