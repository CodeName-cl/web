---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactForm from "@components/ContactForm.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("docs");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatted = post.data.date.toLocaleDateString("es-CL", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={`${post.data.title} | Codename`}
  description={post.data.description}
  ogImage={`https://codename.cl${post.data.image}`}
  ogType="article"
  canonicalUrl={`https://codename.cl/docs/${post.id}`}
  // Docs exist only in Spanish: the /en redirect would land on a 404.
  langRedirect={false}
>
  <Fragment slot="structured-data">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "TechArticle",
        headline: post.data.title,
        description: post.data.description,
        author: {
          "@type": "Person",
          name: post.data.author.name,
          url: post.data.author.url,
        },
        publisher: {
          "@type": "Organization",
          name: "Codename",
          logo: {
            "@type": "ImageObject",
            url: "https://codename.cl/logo.png",
          },
        },
        datePublished: post.data.date.toISOString().split("T")[0],
        image: `https://codename.cl${post.data.image}`,
      })}
    />
  </Fragment>

  <section id="breadcrumb">
    <nav aria-label="breadcrumb">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/docs">Documentación</a></li>
        <li>{post.data.title}</li>
      </ol>
    </nav>
  </section>

  <section id="article" class="article-container">
    <div class="article-content">
      {post.data.video && (
        <video
          class="doc-video"
          controls
          playsinline
          preload="metadata"
          poster={post.data.videoPoster}
        >
          <source src={post.data.video} type="video/mp4" />
        </video>
      )}
      <h1>{post.data.title}</h1>
      <Content />
    </div>
    <aside class="article-sidebar">
      <p><strong>Autor:</strong></p>
      <p>
        <a href={post.data.author.url} target="_blank" rel="noopener noreferrer">{post.data.author.name}</a>
      </p>
      <p><strong>Fecha de modificación:</strong></p>
      <p>{dateFormatted}</p>
    </aside>
  </section>

  <ContactForm />
</BaseLayout>

<style>
  .doc-video {
    display: block;
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(2, 6, 23, 0.18);
    margin: 0 0 2rem;
    background: #020617;
  }
</style>

<style is:global>
  /* Dense guide components, usable from any doc's markdown (Codename branding). */
  .article-content .doc-video-inline { margin: 0.5rem 0 1.25rem; box-shadow: 0 8px 28px rgba(2, 6, 23, 0.14); }
  .article-content .doc-summary {
    display: grid;
    grid-template-columns: 1.4fr 1.2fr 0.8fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--border-radius);
    overflow: hidden;
    margin: 0 0 1.5rem;
  }
  .article-content .doc-summary > div { background: var(--surface); padding: 1rem 1.1rem; }
  /* #article li/p (BaseLayout) justify text with an ID selector; the summary
     needs the same specificity to stay left-aligned and compact. */
  #article .article-content .doc-summary p,
  #article .article-content .doc-summary ul,
  #article .article-content .doc-summary li { margin: 0; font-size: 0.92rem; line-height: 1.5; text-align: left; }
  #article .article-content .doc-summary li + li { margin-top: 0.35rem; }
  .article-content .doc-summary ul { padding-left: 1.1rem; }
  .article-content .doc-label {
    display: block;
    font-family: var(--font-condensed);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }
  .article-content .doc-map {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0 0 2rem;
  }
  .article-content .doc-map a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem 0.4rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--text-strong);
    background: var(--surface);
    text-decoration: none;
  }
  .article-content .doc-map a:hover { border-color: var(--primary); background: var(--indigo-wash); }
  .article-content .doc-map b, .article-content .doc-step {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--brand-black);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    flex: none;
  }
  .article-content h2 .doc-step { width: 2rem; height: 2rem; font-size: 1rem; margin-right: 0.5rem; background: var(--accent); vertical-align: middle; }
  .article-content h2 small, .article-content .doc-map small { font-size: 0.7em; font-weight: 500; color: var(--text-muted); }
  .article-content .doc-where {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--primary-dark);
    background: var(--indigo-wash);
    border-left: 3px solid var(--primary);
    padding: 0.45rem 0.75rem;
    border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
    margin: -0.25rem 0 1rem;
  }
  .article-content .doc-callout {
    padding: 0.8rem 1rem;
    border-radius: var(--border-radius-sm);
    font-size: 0.92rem;
    margin: 1rem 0 1.5rem;
  }
  .article-content .doc-callout.tip { background: var(--indigo-soft); border: 1px solid rgba(99, 102, 241, 0.25); }
  .article-content .doc-callout.warn { background: var(--orange-soft); border: 1px solid rgba(235, 94, 40, 0.3); }
  .article-content .doc-help {
    margin-top: 2rem;
    padding: 1rem 1.2rem;
    border-radius: var(--border-radius);
    background: var(--gradient-hero);
    color: var(--text-on-dark);
  }
  .article-content .doc-help a { color: #fdba74; text-decoration: underline; }
  .article-content table { width: 100%; border-collapse: collapse; font-size: 0.88rem; margin: 1rem 0 1.5rem; }
  .article-content th { text-align: left; background: var(--surface-sunken); font-weight: 600; color: var(--text-strong); }
  .article-content th, .article-content td { padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .article-content td code {
    display: inline;
    white-space: nowrap;
    padding: 0.1rem 0.35rem;
    font-size: 0.78rem;
    background: var(--surface-sunken);
    color: var(--text-strong);
    border-radius: 4px;
  }
  .article-content ol { list-style: decimal; padding-left: 1.4rem; }
  .article-content img { border-radius: var(--border-radius); box-shadow: var(--shadow-lg); border: 1px solid var(--rule-soft); }
  @media (max-width: 720px) {
    .article-content .doc-summary { grid-template-columns: 1fr; }
    .article-content table { display: block; overflow-x: auto; }
  }
</style>
