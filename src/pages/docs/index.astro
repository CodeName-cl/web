---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("docs")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Documentación de las Aplicaciones de Shopify | Codename"
  description="Encuentra guías y tutoriales para aprovechar al máximo las aplicaciones de Shopify de Codename. Configuración, optimización y soluciones rápidas."
  canonicalUrl="https://codename.cl/docs"
>
  <Fragment slot="structured-data">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Codename",
        url: "https://codename.cl",
        logo: "https://codename.cl/logo.png",
        contactPoint: {
          "@type": "ContactPoint",
          telephone: "+56-9-6407-0413",
          contactType: "Customer Support",
          areaServed: "Worldwide",
        },
        sameAs: [
          "https://www.instagram.com/codename.cl",
          "https://www.linkedin.com/company/102651292",
        ],
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Ship Smart",
        operatingSystem: "Shopify",
        applicationCategory: "Ecommerce",
        description: "Calcula tarifas de envío en tiempo real y optimiza costos para tiendas Shopify.",
        url: "https://apps.shopify.com/ship-smart-1",
        image: "https://codename.cl/images/icons/ship-smart.webp",
        offers: { "@type": "Offer", price: "35", priceCurrency: "USD" },
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Easy Image Uploader",
        operatingSystem: "Shopify",
        applicationCategory: "Ecommerce",
        description: "La mejor herramienta para la carga masiva de imágenes en tiendas Shopify.",
        url: "https://apps.shopify.com/image-uploader-6",
        image: "https://codename.cl/images/icons/Image_Uploader.webp",
        offers: { "@type": "Offer", price: "48", priceCurrency: "USD" },
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "BillBoost Boleta O Factura",
        operatingSystem: "Shopify",
        applicationCategory: "Ecommerce",
        description: "Permite a tus clientes seleccionar el tipo de documento en el checkout.",
        url: "https://apps.shopify.com/byf-extensibility",
        image: "https://codename.cl/images/icons/billboost.webp",
        offers: { "@type": "Offer", price: "35", priceCurrency: "USD" },
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "LocFix AI",
        operatingSystem: "Shopify",
        applicationCategory: "Ecommerce",
        description: "Corrige la dirección del usuario usando inteligencia artificial.",
        url: "https://apps.shopify.com/validador-de-direcciones",
        image: "https://codename.cl/images/icons/Lockfix.webp",
        offers: { "@type": "Offer", price: "35", priceCurrency: "USD" },
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Product Sentinel",
        operatingSystem: "Shopify",
        applicationCategory: "Ecommerce",
        description: "Monitorea los precios de tus productos para evitar ventas bajo costo.",
        url: "https://codename.cl/app/product-sentinel",
        image: "https://codename.cl/images/icons/product-sentinel.webp",
        offers: { "@type": "Offer", price: "35", priceCurrency: "USD" },
      })}
    />
  </Fragment>

  <section id="breadcrumb">
    <nav aria-label="breadcrumb">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li>Docs</li>
      </ol>
    </nav>
  </section>

  <section id="articles-section">
    <h1>Documentación de Ship Smart</h1>
    <h2>Guías y tutoriales para configurar Ship Smart en Shopify</h2>

    <div id="articles" class="fade-in">
      {
        posts.map((post) => (
          <div class="article-card">
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <a href={`/docs/${post.id}`}>Leer más &rarr;</a>
          </div>
        ))
      }
    </div>

    <p class="related-docs">
      Explora también nuestras guías para otras aplicaciones:
      <a href="https://apps.shopify.com/image-uploader-6" target="_blank">Easy Image Uploader</a>,
      <a href="https://apps.shopify.com/byf-extensibility">BillBoost</a> y
      <a href="https://apps.shopify.com/validador-de-direcciones">LocFix AI</a>.
    </p>

    <h2 class="faq-heading">Preguntas Frecuentes sobre Ship Smart</h2>
    <details>
      <summary>¿Cómo configuro Ship Smart en Shopify?</summary>
      <p>Puedes seguir nuestra <a href="/docs/ship-smart-configuracion-inicial">guía paso a paso</a> para configurar Ship Smart en tu tienda Shopify.</p>
    </details>
    <details>
      <summary>¿Ship Smart funciona con cualquier tienda Shopify?</summary>
      <p>Sí, Ship Smart es compatible con cualquier tienda Shopify y permite configurar tarifas de envío personalizadas.</p>
    </details>
  </section>
</BaseLayout>

<style>
  #breadcrumb {
    padding-bottom: 0;
  }
  #articles-section {
    padding-top: 30px;
  }
  #articles-section h1 {
    margin-bottom: 12px;
  }
  #articles-section h2 {
    margin-bottom: 24px;
    color: var(--text-muted);
    font-weight: 500;
  }
  .faq-heading {
    margin-top: 48px;
  }
  #articles {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .article-card {
    display: flex;
    flex-direction: column;
    background-color: var(--surface);
    padding: 24px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    border-radius: var(--border-radius);
    flex: 1 1 calc(50% - 20px);
    max-width: calc(50% - 20px);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .article-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .article-card h3 {
    font-size: 1rem;
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .article-card p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin-bottom: 16px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .article-card a {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--primary);
    text-decoration: none;
    margin-top: auto;
  }
  .article-card a:hover {
    text-decoration: underline;
  }
  .related-docs {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin-top: 24px;
  }
  .related-docs a {
    color: var(--primary);
    text-decoration: underline;
  }
  .related-docs a:hover {
    text-decoration: none;
  }
  details {
    margin-bottom: 12px;
  }
  details summary {
    cursor: pointer;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--border-radius);
    font-weight: 500;
    transition: all 0.2s;
  }
  details summary:hover {
    border-color: var(--border-hover, rgba(0, 0, 0, 0.15));
  }
  details[open] summary {
    border-radius: var(--border-radius) var(--border-radius) 0 0;
    border-bottom: none;
  }
  details p {
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: none;
    border-radius: 0 0 var(--border-radius) var(--border-radius);
  }
  details p a {
    color: var(--primary);
    text-decoration: underline;
  }

  @media screen and (min-width: 768px) {
    #articles-section {
      max-width: 720px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 20px;
      padding-right: 20px;
    }
    .article-card {
      flex: 1 1 calc(33.33% - 20px);
      max-width: calc(33.33% - 20px);
    }
  }
  @media screen and (min-width: 992px) {
    #articles-section {
      max-width: 960px;
    }
    .article-card {
      flex: 1 1 calc(25% - 20px);
      max-width: calc(25% - 20px);
    }
  }
  @media screen and (min-width: 1200px) {
    #articles-section {
      max-width: 1140px;
    }
  }
  @media screen and (min-width: 1400px) {
    #articles-section {
      max-width: 1320px;
    }
  }
</style>
