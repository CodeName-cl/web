---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactForm from "@components/ContactForm.astro";
import { getCollection, render } from "astro:content";
import { useTranslations, getLocaleFromPostId } from "@i18n/utils";

const lang = "en";
const t = useTranslations(lang);

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => getLocaleFromPostId(post.id).locale === "en")
    .map((post) => {
      const { slug } = getLocaleFromPostId(post.id);
      return {
        params: { slug },
        props: { post },
      };
    });
}

const { post } = Astro.props;
const { Content } = await render(post);
const { slug } = getLocaleFromPostId(post.id);

const dateFormatted = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={`${post.data.title} | Codename`}
  lang={lang}
  description={post.data.description}
  ogImage={`https://codename.cl${post.data.image}`}
  ogType="article"
  canonicalUrl={`https://codename.cl/en/blog/${slug}`}
>
  <Fragment slot="structured-data">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        headline: post.data.title,
        description: post.data.description,
        author: {
          "@type": "Person",
          name: post.data.author.name,
          url: post.data.author.url,
        },
        publisher: {
          "@type": "Organization",
          name: "Codename",
          logo: {
            "@type": "ImageObject",
            url: "https://codename.cl/logo.png",
          },
        },
        datePublished: post.data.date.toISOString().split("T")[0],
        image: `https://codename.cl${post.data.image}`,
      })}
    />
  </Fragment>

  <section id="breadcrumb">
    <nav aria-label="breadcrumb">
      <ol>
        <li><a href="/en">{t("breadcrumb.home")}</a></li>
        <li><a href="/en/blog">{t("blog.title")}</a></li>
        <li>{post.data.title}</li>
      </ol>
    </nav>
  </section>

  <section id="article" class="article-container">
    <div class="article-content">
      <h1>{post.data.title}</h1>
      <Content />
    </div>
    <aside class="article-sidebar">
      <p><strong>{t("article.author")}:</strong></p>
      <p>
        <a href={post.data.author.url} target="_blank" rel="noopener noreferrer">{post.data.author.name}</a>
      </p>
      <p><strong>{t("article.date")}:</strong></p>
      <p>{dateFormatted}</p>
    </aside>
  </section>

  <ContactForm lang={lang} />
</BaseLayout>
