---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactForm from "@components/ContactForm.astro";
import { getCollection } from "astro:content";
import { useTranslations, getLocaleFromPostId } from "@i18n/utils";

const lang = "en";
const t = useTranslations(lang);

const posts = (await getCollection("blog"))
  .filter((post) => getLocaleFromPostId(post.id).locale === "en")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout
  title="Blog | Codename"
  lang={lang}
  description={t("blog.description")}
  canonicalUrl="https://codename.cl/en/blog"
  alternateEs="https://codename.cl/blog"
  alternateEn="https://codename.cl/en/blog"
>
  <section id="breadcrumb">
    <nav aria-label="breadcrumb">
      <ol>
        <li><a href="/en">{t("breadcrumb.home")}</a></li>
        <li>{t("blog.title")}</li>
      </ol>
    </nav>
  </section>

  <section id="articles-section">
    <h1>{t("blog.title")}</h1>
    <div id="articles" class="fade-in">
      {
        posts.map((post) => {
          const { slug } = getLocaleFromPostId(post.id);
          return (
            <div class="article-card">
              <h3>{post.data.title}</h3>
              <time class="article-card-date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <p>{post.data.description}</p>
              <a href={`/en/blog/${slug}`}>{t("blog.readMore")} &rarr;</a>
            </div>
          );
        })
      }
    </div>
  </section>

  <ContactForm lang={lang} />
</BaseLayout>

<style>
  #breadcrumb {
    padding-bottom: 0;
  }
  #articles-section {
    padding-top: 30px;
  }
  #articles-section h1 {
    margin-bottom: 32px;
  }
  #articles {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .article-card {
    display: flex;
    flex-direction: column;
    background-color: var(--surface);
    padding: 24px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    border-radius: var(--border-radius);
    flex: 1 1 calc(50% - 20px);
    max-width: calc(50% - 20px);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .article-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .article-card h3 {
    font-size: 1rem;
    margin-bottom: 6px;
    line-height: 1.3;
  }
  .article-card-date {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .article-card p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin-bottom: 16px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .article-card a {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--primary);
    text-decoration: none;
    margin-top: auto;
  }
  .article-card a:hover {
    text-decoration: underline;
  }

  @media screen and (min-width: 768px) {
    #articles-section {
      max-width: 720px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 20px;
      padding-right: 20px;
    }
    .article-card {
      flex: 1 1 calc(33.33% - 20px);
      max-width: calc(33.33% - 20px);
    }
  }
  @media screen and (min-width: 992px) {
    #articles-section {
      max-width: 960px;
    }
    .article-card {
      flex: 1 1 calc(20% - 20px);
      max-width: calc(20% - 20px);
    }
  }
  @media screen and (min-width: 1200px) {
    #articles-section {
      max-width: 1140px;
    }
  }
  @media screen and (min-width: 1400px) {
    #articles-section {
      max-width: 1320px;
    }
  }
</style>
