<!-- Gravity Grid Effect -->
<script is:inline>
  (function () {
    const canvas = document.getElementById("gravity-grid");
    const ctx = canvas.getContext("2d");
    const hero = document.getElementById("home");

    let width, height;
    let mouse = { x: -1000, y: -1000 };
    let gridPoints = [];
    const gridSpacing = 55;
    const influenceRadius = 220;
    const maxDisplacement = 25;

    let particles = [];
    const particleCount = 40;
    const particleSpeed = 0.8;

    function resize() {
      width = hero.offsetWidth;
      height = hero.offsetHeight;
      canvas.width = width;
      canvas.height = height;
      initGrid();
      initParticles();
    }

    function initParticles() {
      particles = [];
      for (let i = 0; i < particleCount; i++) {
        particles.push(createParticle());
      }
    }

    function createParticle(fromBottom = false) {
      return {
        x: Math.random() * width,
        y: fromBottom ? height + 10 : Math.random() * height,
        size: Math.random() * 2 + 1,
        speedY: -(Math.random() * particleSpeed + 0.3),
        speedX: (Math.random() - 0.5) * 0.3,
        opacity: Math.random() * 0.3 + 0.1,
      };
    }

    function updateParticles() {
      for (let p of particles) {
        p.y += p.speedY;
        p.x += p.speedX;

        if (mouse.x > 0 && mouse.y > 0) {
          const dx = mouse.x - p.x;
          const dy = mouse.y - p.y;
          const distance = Math.sqrt(dx * dx + dy * dy);

          if (distance < influenceRadius * 1.5) {
            const force = (1 - distance / (influenceRadius * 1.5)) * 0.5;
            p.x += dx * force * 0.02;
            p.y += dy * force * 0.02;
          }
        }

        if (p.y < -10) {
          Object.assign(p, createParticle(true));
        }
      }
    }

    function drawParticles() {
      for (let p of particles) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${p.opacity})`;
        ctx.fill();
      }
    }

    function initGrid() {
      gridPoints = [];
      const cols = Math.ceil(width / gridSpacing) + 1;
      const rows = Math.ceil(height / gridSpacing) + 1;

      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          gridPoints.push({
            originX: i * gridSpacing,
            originY: j * gridSpacing,
            x: i * gridSpacing,
            y: j * gridSpacing,
          });
        }
      }
    }

    function getPoint(col, row) {
      const index = col * (Math.ceil(height / gridSpacing) + 1) + row;
      return gridPoints[index];
    }

    function updatePoints() {
      const particleInfluence = 70;
      const particleDisplacement = 12;

      for (let point of gridPoints) {
        let targetX = point.originX;
        let targetY = point.originY;

        const dx = mouse.x - point.originX;
        const dy = mouse.y - point.originY;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < influenceRadius) {
          const force = (1 - distance / influenceRadius) * maxDisplacement;
          const angle = Math.atan2(dy, dx);
          targetX += Math.cos(angle) * force;
          targetY += Math.sin(angle) * force;
        }

        for (let p of particles) {
          const pdx = p.x - point.originX;
          const pdy = p.y - point.originY;
          const pdist = Math.sqrt(pdx * pdx + pdy * pdy);

          if (pdist < particleInfluence && pdist > 0) {
            const pforce =
              (1 - pdist / particleInfluence) * particleDisplacement;
            const pangle = Math.atan2(pdy, pdx);
            targetX += Math.cos(pangle) * pforce;
            targetY += Math.sin(pangle) * pforce;
          }
        }

        point.x += (targetX - point.x) * 0.15;
        point.y += (targetY - point.y) * 0.15;
      }
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);

      if (mouse.x > 0 && mouse.y > 0) {
        const gradient = ctx.createRadialGradient(
          mouse.x,
          mouse.y,
          0,
          mouse.x,
          mouse.y,
          influenceRadius
        );
        gradient.addColorStop(0, "rgba(99, 102, 241, 0.06)");
        gradient.addColorStop(0.5, "rgba(99, 102, 241, 0.02)");
        gradient.addColorStop(1, "rgba(99, 102, 241, 0)");
        ctx.fillStyle = gradient;
        ctx.fillRect(
          mouse.x - influenceRadius,
          mouse.y - influenceRadius,
          influenceRadius * 2,
          influenceRadius * 2
        );
      }

      ctx.strokeStyle = "rgba(255, 255, 255, 0.035)";
      ctx.lineWidth = 1;

      const cols = Math.ceil(width / gridSpacing) + 1;
      const rows = Math.ceil(height / gridSpacing) + 1;

      for (let j = 0; j < rows; j++) {
        ctx.beginPath();
        for (let i = 0; i < cols; i++) {
          const point = getPoint(i, j);
          if (point) {
            if (i === 0) {
              ctx.moveTo(point.x, point.y);
            } else {
              ctx.lineTo(point.x, point.y);
            }
          }
        }
        ctx.stroke();
      }

      for (let i = 0; i < cols; i++) {
        ctx.beginPath();
        for (let j = 0; j < rows; j++) {
          const point = getPoint(i, j);
          if (point) {
            if (j === 0) {
              ctx.moveTo(point.x, point.y);
            } else {
              ctx.lineTo(point.x, point.y);
            }
          }
        }
        ctx.stroke();
      }
    }

    function animate() {
      updatePoints();
      updateParticles();
      draw();
      drawParticles();
      requestAnimationFrame(animate);
    }

    hero.addEventListener("mousemove", (e) => {
      const rect = hero.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    hero.addEventListener("mouseleave", () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    window.addEventListener("resize", resize);

    resize();
    animate();
  })();
</script>

<style>
  /* Hero Section */
  #home {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 24px;
    background: var(--gradient-hero);
    color: var(--dark-text);
    position: relative;
    overflow: hidden;
  }
  #home::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 20% 80%,
        rgba(235, 94, 40, 0.15) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 20%,
        rgba(99, 102, 241, 0.1) 0%,
        transparent 50%
      );
    pointer-events: none;
  }
  #gravity-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  #home > *:not(#gravity-grid) {
    position: relative;
    z-index: 1;
  }
  #home h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: 800px;
    margin-bottom: 20px;
    background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  #home p {
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    color: #94a3b8;
    max-width: 500px;
  }
  #home button {
    margin-top: 40px;
    padding: 16px 32px;
    font-size: 1.0625rem;
    font-weight: 600;
    background: var(--gradient-accent);
    color: white;
    border: none;
    border-radius: var(--border-radius);
    box-shadow:
      0 4px 14px rgba(235, 94, 40, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    min-height: 52px;
  }
  #home button:hover {
    transform: translateY(-3px);
    box-shadow:
      0 8px 25px rgba(235, 94, 40, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }
  #home button:active {
    transform: translateY(-1px);
  }
  .btn-call-to-action {
