      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Codename",
      "url": "https://codename.cl",
      "logo": "https://codename.cl/logo.png",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+56-9-6407-0413",
        "contactType": "Customer Support",
        "areaServed": "Worldwide"
      },
      "sameAs": [
        "https://www.instagram.com/codename.cl",
        "https://www.linkedin.com/company/102651292"
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
