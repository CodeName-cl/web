---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="404 - Página no encontrada | Codename" description="Lo sentimos, no pudimos encontrar la página que buscabas.">
  <section id="not-found">
    <span class="file-no"><span>//</span> ERROR · Página no encontrada</span>
    <h1>404</h1>
    <p>Lo sentimos, no pudimos encontrar la página que buscabas.</p>
    <a href="/" class="btn-home">Volver al Inicio</a>
  </section>
</BaseLayout>

<script is:inline>
  // Redirect .html URLs to clean URLs (e.g. /docs/slug.html → /docs/slug)
  (function () {
    var path = window.location.pathname;
    if (path.endsWith(".html") && path !== "/404.html") {
      var clean = path.replace(/\.html$/, "");
      window.location.replace(clean + window.location.search + window.location.hash);
    }
  })();
</script>

<style>
  #not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    padding: 80px 20px;
  }
  #not-found h1 {
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--indigo);
    margin-bottom: 16px;
  }
  #not-found p {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 32px;
    max-width: 480px;
    line-height: 1.6;
  }
  .btn-home {
    display: inline-block;
    background: var(--gradient-orange);
    color: #ffffff;
    padding: 14px 28px;
    border-radius: var(--border-radius);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(235, 94, 40, 0.30);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn-home:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 25px rgba(235, 94, 40, 0.40);
  }
  .btn-home:active {
    transform: scale(0.98);
  }
</style>
