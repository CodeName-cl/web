---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="404 - Página no encontrada | Codename" description="Lo sentimos, no pudimos encontrar la página que buscabas.">
  <section id="not-found">
    <h1>404</h1>
    <p>Lo sentimos, no pudimos encontrar la página que buscabas.</p>
    <a href="/" class="btn-home">Volver al Inicio</a>
  </section>
</BaseLayout>

<script is:inline>
  // Redirect .html URLs to clean URLs (e.g. /docs/slug.html → /docs/slug)
  (function () {
    var path = window.location.pathname;
    if (path.endsWith(".html") && path !== "/404.html") {
      var clean = path.replace(/\.html$/, "");
      window.location.replace(clean + window.location.search + window.location.hash);
    }
  })();
</script>

<style>
  #not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    padding: 40px 20px;
  }
  #not-found h1 {
    font-size: 6rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 16px;
    line-height: 1;
  }
  #not-found p {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 32px;
    max-width: 480px;
  }
  .btn-home {
    display: inline-block;
    background-color: var(--primary);
    color: #fff;
    padding: 12px 28px;
    border-radius: var(--border-radius);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-home:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
</style>
