---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactForm from "@components/ContactForm.astro";
import { getCollection } from "astro:content";
import { useTranslations, getLocaleFromPostId } from "@i18n/utils";

const lang = "es";
const t = useTranslations(lang);

const posts = (await getCollection("blog"))
  .filter((post) => getLocaleFromPostId(post.id).locale === "es")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString("es-CL", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout
  title="Blog | Codename"
  lang={lang}
  description={t("blog.description")}
  canonicalUrl="https://codename.cl/blog"
  alternateEs="https://codename.cl/blog"
  alternateEn="https://codename.cl/en/blog"
>
  <section id="breadcrumb">
    <nav aria-label="breadcrumb">
      <ol>
        <li><a href="/">{t("breadcrumb.home")}</a></li>
        <li>{t("blog.title")}</li>
      </ol>
    </nav>
  </section>

  <section id="articles-section">
    <div class="blog-header">
      <span class="file-no"><span>//</span> Blog · {posts.length} artículos</span>
      <h1>{t("blog.title")}</h1>
    </div>
    <div id="articles" class="fade-in">
      {
        posts.map((post) => {
          const { slug } = getLocaleFromPostId(post.id);
          return (
            <a href={`/blog/${slug}`} class="article-card">
              <div class="article-cover">
                <img src={post.data.image} alt={post.data.title} loading="lazy" />
              </div>
              <div class="article-card-content">
                <div class="article-meta">
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                  {post.data.tags?.[0] && (
                    <span class="article-tag">{post.data.tags[0]}</span>
                  )}
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="article-more">
                  {t("blog.readMore")} <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <ContactForm lang={lang} />
</BaseLayout>

<style>
  #breadcrumb {
    padding-bottom: 0;
  }
  #articles-section {
    padding-top: 40px;
    padding-bottom: 64px;
  }
  .blog-header {
    max-width: 1080px;
    margin: 0 auto 32px;
  }
  .blog-header h1 {
    margin-top: 4px;
  }
  #articles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    max-width: 1080px;
    margin: 0 auto;
  }
  .article-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                border-color 0.25s, box-shadow 0.25s;
  }
  .article-card:hover {
    transform: translateY(-2px);
    border-color: rgba(99, 102, 241, 0.3);
    box-shadow: var(--shadow-lg);
  }
  .article-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--slate-100);
  }
  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .article-card:hover .article-cover img {
    transform: scale(1.04);
  }
  .article-card-content {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    flex-wrap: wrap;
  }
  .article-tag {
    padding: 2px 8px;
    background: var(--indigo-soft);
    color: var(--indigo);
    border-radius: 4px;
    font-weight: 500;
  }
  .article-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-strong);
    margin-bottom: 8px;
    letter-spacing: -0.015em;
    transition: color 0.2s;
  }
  .article-card:hover h3 {
    color: var(--indigo);
  }
  .article-card p {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 14px;
    flex-grow: 1;
  }
  .article-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--indigo);
    margin-top: auto;
    transition: gap 0.2s;
  }
  .article-card:hover .article-more {
    gap: 10px;
  }

  @media screen and (min-width: 768px) {
    #articles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (min-width: 1024px) {
    #articles {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
