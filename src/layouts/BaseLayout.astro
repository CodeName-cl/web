---
import type { Lang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title: string;
  lang?: Lang;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  alternateEs?: string;
  alternateEn?: string;
}

const {
  title,
  lang = "es",
  description,
  ogImage = "https://codename.cl/logo.png",
  ogType = "website",
  canonicalUrl,
  alternateEs,
  alternateEn,
} = Astro.props;

const t = useTranslations(lang);
const desc = description || t("meta.description");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    <meta name="keywords" content={t("meta.keywords")} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl ?? Astro.url.href} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonicalUrl ?? Astro.url.href} />

    {alternateEs && <link rel="alternate" hreflang="es" href={alternateEs} />}
    {alternateEn && <link rel="alternate" hreflang="en" href={alternateEn} />}

    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <!-- DNS Prefetch + Preconnect -->
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Google Fonts — aligned with branding.codename.cl -->
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&family=Inter:wght@300;400;500;600;700;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&family=Inter:wght@300;400;500;600;700;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-5CWP9SPQ");
    </script>

    <title>{title}</title>

    <!-- Language detection redirect -->
    <script is:inline>
      (function () {
        if (document.cookie.indexOf("lang_pref=") !== -1) return;
        var isEnglish =
          (navigator.language || navigator.userLanguage || "").substring(0, 2) === "en";
        if (isEnglish && window.location.pathname.indexOf("/en") !== 0) {
          document.cookie = "lang_pref=en;path=/;max-age=31536000;SameSite=Lax";
          window.location.replace("/en" + window.location.pathname);
        } else {
          document.cookie =
            "lang_pref=es;path=/;max-age=31536000;SameSite=Lax";
        }
      })();
    </script>

    <!-- Structured Data slot -->
    <slot name="structured-data" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t("skip")}</a>

    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5CWP9SPQ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    <Header lang={lang} />

    <main id="main-content">
      <slot />
    </main>

    <Footer lang={lang} />

    <!-- Intersection Observer for fade-in animations -->
    <script is:inline>
      const fadeElements = document.querySelectorAll(".fade-in");
      const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      };
      const fadeObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            fadeObserver.unobserve(entry.target);
          }
        });
      }, observerOptions);
      fadeElements.forEach((el) => fadeObserver.observe(el));
    </script>
  </body>
</html>

<style is:global>
  /* =========================================================
   * Design tokens — aligned with branding.codename.cl
   * Inter + JetBrains Mono + Archivo Narrow (condensed display).
   * Slate palette, brand-black #020617, indigo-accent, orange-cta.
   * ========================================================= */
  :root {
    /* Brand colors — from branding.codename.cl */
    --brand-black: #020617;
    --indigo: #6366f1;
    --indigo-soft: rgba(99, 102, 241, 0.10);
    --indigo-wash: rgba(99, 102, 241, 0.05);
    --orange: #eb5e28;
    --orange-soft: rgba(235, 94, 40, 0.10);

    /* Slate neutrals */
    --slate-50: #f8fafc;
    --slate-100: #f1f5f9;
    --slate-200: #e2e8f0;
    --slate-300: #cbd5e1;
    --slate-400: #94a3b8;
    --slate-500: #64748b;
    --slate-600: #475569;
    --slate-700: #334155;
    --slate-800: #1e293b;
    --slate-900: #0f172a;
    --slate-950: #020617;

    /* Surfaces */
    --surface: #ffffff;
    --surface-sunken: var(--slate-50);
    --surface-dark: var(--brand-black);

    /* Text */
    --text-strong: var(--slate-900);
    --text: var(--slate-700);
    --text-muted: var(--slate-500);
    --text-faint: var(--slate-400);
    --text-on-dark: #f1f5f9;
    --text-on-dark-muted: #94a3b8;

    /* Rules */
    --rule: var(--slate-200);
    --rule-soft: var(--slate-100);
    --rule-on-dark: rgba(255, 255, 255, 0.10);
    --rule-on-dark-soft: rgba(255, 255, 255, 0.06);

    /* Shadows — soft, modern SaaS */
    --shadow-sm: 0 1px 2px rgba(2, 6, 23, 0.04), 0 1px 3px rgba(2, 6, 23, 0.06);
    --shadow-md: 0 4px 6px -1px rgba(2, 6, 23, 0.08),
      0 2px 4px -2px rgba(2, 6, 23, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(2, 6, 23, 0.08),
      0 4px 6px -4px rgba(2, 6, 23, 0.06);
    --shadow-xl: 0 20px 25px -5px rgba(2, 6, 23, 0.10),
      0 8px 10px -6px rgba(2, 6, 23, 0.06);

    /* Type stacks */
    --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
    --font-condensed: "Archivo Narrow", sans-serif;
    /* body/display both use Inter — brand does not use serif */
    --font-display: var(--font-sans);
    --font-body: var(--font-sans);

    /* Gradients */
    --gradient-hero: linear-gradient(135deg, #020617 0%, #0f172a 50%, #020617 100%);
    --gradient-orange: linear-gradient(135deg, #eb5e28 0%, #f97316 100%);
    --gradient-indigo: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);

    /* Shape — brand uses generous rounded-2xl (16px) */
    --border-radius-sm: 6px;
    --border-radius: 12px;
    --border-radius-lg: 16px;
    --border-radius-xl: 24px;

    /* ---- LEGACY ALIASES (blog/docs pages depend on these) ---- */
    --primary: var(--indigo);
    --primary-dark: #4f46e5;
    --primary-light: #818cf8;
    --accent: var(--orange);
    --accent-dark: #d4501f;
    --accent-light: #f97316;
    --soft-indigo: #eef2ff;
    --background: var(--slate-50);
    --border: var(--rule);
    --border-hover: var(--slate-300);
    --text-secondary: var(--text);
    --dark-bg: var(--brand-black);
    --dark-surface: var(--slate-900);
    --dark-text: var(--text-on-dark);
    --color-00: var(--text-strong);
    --color-01: var(--text);
    --color-03: var(--surface);
    --color-04: var(--slate-50);
    --color-05: var(--orange);
    --gradient-accent: var(--gradient-orange);
    --gradient-primary: var(--gradient-indigo);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
  }
  body,
  html {
    height: 100%;
    font-family: var(--font-sans);
    font-weight: 400;
  }
  body {
    font-size: 16px;
    line-height: 1.7;
    background-color: var(--slate-50);
    color: var(--text);
    letter-spacing: -0.01em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Typography — Inter, tight tracking, bold hierarchy */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--text-strong);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 20px;
    line-height: 1.15;
  }
  h3 {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 600;
  }
  p,
  ul {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text);
  }

  /* Tactical tag — mono label, used for section markers */
  .tac-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .tac-label::before {
    content: "";
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  .tac-label strong {
    color: var(--indigo);
    font-weight: 600;
  }

  /* Section file marker — mono, small, restrained */
  .file-no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 16px;
  }
  .file-no span { color: var(--orange); font-weight: 600; }

  /* Big Archivo-Narrow display number — condensed brand font */
  .n-big {
    font-family: var(--font-condensed);
    font-weight: 700;
    font-size: 2.25rem;
    line-height: 0.9;
    letter-spacing: 0;
    color: var(--indigo);
  }

  img,
  video {
    max-width: 100%;
    height: auto;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  ol,
  ul {
    list-style: disc;
    padding-left: 20px;
  }
  footer ul,
  header ul {
    list-style: none;
    padding-left: 0;
  }
  table {
    border-collapse: collapse;
    width: 100%;
  }

  /* Buttons — modern SaaS, rounded, gradient CTA */
  button {
    cursor: pointer;
    background: transparent;
    border: none;
    font-family: inherit;
    font-weight: 600;
    font-size: 1rem;
    padding: 12px 24px;
    border-radius: var(--border-radius);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  button:hover {
    transform: scale(1.02);
  }
  button:active {
    transform: scale(0.98);
  }
  button,
  input,
  textarea {
    font-family: inherit;
    outline: none;
  }
  code {
    padding: 10px;
    display: block;
    background-color: var(--brand-black);
    color: var(--text-on-dark);
    border-radius: var(--border-radius);
    font-family: var(--font-mono);
  }

  /* Forms — modern SaaS with soft borders */
  input,
  textarea {
    width: 100%;
    padding: 14px 16px;
    font-size: 1rem;
    background-color: var(--surface);
    border: 2px solid var(--rule);
    border-radius: var(--border-radius);
    color: var(--text-strong);
    resize: none;
    transition: all 0.2s ease;
  }
  input:hover,
  textarea:hover {
    border-color: var(--slate-300);
  }
  input:focus,
  textarea:focus {
    border-color: var(--indigo);
    box-shadow: 0 0 0 4px var(--indigo-wash);
  }
  textarea {
    min-height: 150px;
  }
  label {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text);
    margin-bottom: 8px;
    margin-top: 16px;
  }
  ::placeholder {
    color: var(--text-faint);
  }

  /* Sections */
  section {
    padding: 80px 20px;
  }

  /* SVG Logo — paper on ink, ink on paper */
  .cls-1 {
    fill: rgba(255, 255, 255, 0.95);
    transition: fill 0.3s ease;
  }

  /* Animations */
  .fade-in {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger animations for cards */
  .fade-in.visible .app-card,
  .fade-in.visible .article-card,
  .fade-in.visible .feature {
    animation: fadeInUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    opacity: 0;
  }
  .fade-in.visible .app-card:nth-child(1),
  .fade-in.visible .article-card:nth-child(1),
  .fade-in.visible .feature:nth-child(1) {
    animation-delay: 0.1s;
  }
  .fade-in.visible .app-card:nth-child(2),
  .fade-in.visible .article-card:nth-child(2),
  .fade-in.visible .feature:nth-child(2) {
    animation-delay: 0.15s;
  }
  .fade-in.visible .app-card:nth-child(3),
  .fade-in.visible .article-card:nth-child(3),
  .fade-in.visible .feature:nth-child(3) {
    animation-delay: 0.2s;
  }
  .fade-in.visible .app-card:nth-child(4),
  .fade-in.visible .article-card:nth-child(4) {
    animation-delay: 0.25s;
  }
  .fade-in.visible .app-card:nth-child(5),
  .fade-in.visible .article-card:nth-child(5) {
    animation-delay: 0.3s;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Focus states for accessibility */
  :focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 2px;
  }
  a:focus-visible,
  button:focus-visible {
    border-radius: 4px;
  }

  /* Skip link for keyboard navigation */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--indigo);
    color: white;
    padding: 12px 24px;
    border-radius: 0 0 8px 8px;
    z-index: 9999;
    transition: top 0.2s;
    font-weight: 600;
  }
  .skip-link:focus {
    top: 0;
  }

  /* Utility: hide companion */
  #shadow-host-companion {
    display: none;
  }

  /* Breadcrumb */
  #breadcrumb nav[aria-label="breadcrumb"] ol {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  #breadcrumb nav[aria-label="breadcrumb"] li {
    margin-right: 8px;
  }
  #breadcrumb nav[aria-label="breadcrumb"] li + li::before {
    content: ">";
    margin-right: 8px;
    color: var(--text-muted);
  }

  /* Article Page */
  #article {
    max-width: 100%;
    margin: 0 auto;
    line-height: 1.8;
    padding: 30px;
  }
  #article li,
  #article p {
    margin-bottom: 20px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-align: justify;
  }
  #article h1,
  #article h2,
  #article h3 {
    margin-top: 32px;
    margin-bottom: 16px;
  }
  #article h2 {
    font-size: 1.5rem;
  }
  .article-container {
    display: flex;
    flex-direction: column;
  }
  .article-content {
    order: 2;
  }
  .article-content h3 {
    font-size: 1.25rem;
  }
  .article-sidebar {
    order: 1;
    padding-left: 0;
    padding-bottom: 20px;
    flex: 1 1 25%;
    padding-top: 20px;
  }
  .article-sidebar p {
    margin-bottom: 5px !important;
  }

  /* ========== TABLET (768px+) ========== */
  @media screen and (min-width: 768px) {
    .article-container {
      flex-direction: row;
    }
    .article-content {
      order: 1;
      flex: 3 1 75%;
    }
    .article-sidebar {
      order: 2;
      padding-left: 20px;
      padding-bottom: 0;
    }

    #apps-section,
    #article,
    #articles-section,
    #breadcrumb,
    #contact,
    #newsletter-section,
    #toc,
    #why-choose-us,
    .footer-content {
      max-width: 720px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  /* ========== DESKTOP (992px+) ========== */
  @media screen and (min-width: 992px) {
    #apps-section,
    #article,
    #articles-section,
    #breadcrumb,
    #contact,
    #newsletter-section,
    #toc,
    #why-choose-us,
    .footer-content,
    .header-content {
      max-width: 960px;
    }
  }

  /* ========== LARGE DESKTOP (1200px+) ========== */
  @media screen and (min-width: 1200px) {
    #apps-section,
    #article,
    #articles-section,
    #breadcrumb,
    #contact,
    #newsletter-section,
    #toc,
    #why-choose-us,
    .footer-content,
    .header-content {
      max-width: 1140px;
    }
  }

  /* ========== XL DESKTOP (1400px+) ========== */
  @media screen and (min-width: 1400px) {
    #apps-section,
    #articles-section,
    #breadcrumb,
    #contact,
    #newsletter-section,
    #toc,
    #why-choose-us,
    .footer-content,
    .header-content {
      max-width: 1320px;
    }
  }
</style>
